# Python
venv/
*/venv/
**/__pycache__/
*.pyc

# Logs
*.log
*.json.gz
# ...except the decoy log files that are Cowrie honeyfs bait content, not
# real runtime logs - see honeypot/README-honeyfs.md
!honeypot/honeyfs-overlay/**/*.log

# log_watcher.py/realtime_alert.py's saved read-offset state (see
# OFFSET_FILE in each) - real per-machine runtime state, not project content
*.offset.json

# Sensitive
.env
!honeypot/honeyfs-overlay/**/.env
*.mmdb
secrets/*.txt
secrets/mongodb_exporter.env

# Cowrie runtime files (không cần push)
honeypot/cowrie-src/var/
honeypot/cowrie-src/cowrie-env/
honeypot/cowrie-src/.tox/
honeypot/cowrie-src/.git/

# Không push file log Cowrie
honeypot/cowrie.json

# Local dev-tool state (Claude Code CLI / CodeGraph index) - máy ai người
# nấy có, không liên quan tới người khác clone repo
.claude/settings.local.json
.codegraph/

# IP/cổng/instance ID thật của VPS - chỉ giữ local, DEPLOY_LOG.md (tracked)
# dùng placeholder thay cho các giá trị này
DEPLOY_LOG.local.md
