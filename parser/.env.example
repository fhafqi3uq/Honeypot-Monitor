# Used by main.py, auth.py, log_watcher.py, cleanup.py (parser.py, the
# one-shot demo-seed importer, still hardcodes localhost:27017/"honeypot" -
# it's a manual seed tool, not a long-running service).
MONGO_URL=mongodb://localhost:27017
DB_NAME=honeypot

# Required by auth.py - generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# There is no default; main.py refuses to start without this set.
#
# Only needed here for the NATIVE venv workflow (start.sh) - if you're
# running via Docker Compose instead, put this in secrets/jwt_secret_key.txt
# (see secrets/README.md) rather than here; docker-compose.yml delivers it
# to the container as a mounted file, not a plaintext env var.
JWT_SECRET_KEY=

# Exact origin the dashboard is served from - must match for cookies/CORS
# to work. Change this if you serve the dashboard from somewhere else.
DASHBOARD_ORIGIN=http://localhost:8080
