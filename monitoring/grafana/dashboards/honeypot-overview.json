    {
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 25
      },
      "id": 30,
      "title": "MongoDB",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "options": {
                "0": {
                  "text": "DOWN"
                },
                "1": {
                  "text": "UP"
                }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 0,
        "y": 26
      },
      "id": 31,
      "targets": [
        {
          "expr": "mongodb_up",
          "refId": "A"
        }
      ],
      "title": "MongoDB up",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 10,
        "x": 4,
        "y": 26
      },
      "id": 32,
      "targets": [
        {
          "expr": "mongodb_ss_connections{conn_type=~\"current|available|active\"}",
          "legendFormat": "{{conn_type}}",
          "refId": "A"
        }
      ],
      "title": "MongoDB connections",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 10,
        "x": 14,
        "y": 26
      },
      "id": 33,
      "targets": [
        {
          "expr": "sum by (legacy_op_type) (rate(mongodb_ss_opcounters[5m]))",
