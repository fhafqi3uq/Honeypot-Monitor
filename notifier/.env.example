# Required by bot.py / realtime_alert.py / daily_report.py / telegram_commands.py.
# Get TELEGRAM_TOKEN from @BotFather, and TELEGRAM_CHAT_ID by messaging your
# bot once and checking https://api.telegram.org/bot<TOKEN>/getUpdates.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Optional - AbuseIPDB free tier key, used by bot.py's check_abuseipdb() to
# score attacker IPs. Leave blank and it just always scores 0.
ABUSEIPDB_KEY=

# Only read when running via Docker Compose (docker-compose.yml sets these
# to point at the "mongo" service) - the native venv workflow (start.sh)
# doesn't need them, since telegram_commands.py/realtime_alert.py default to
# mongodb://localhost:27017 / "honeypot" when unset.
MONGO_URL=mongodb://localhost:27017
DB_NAME=honeypot
